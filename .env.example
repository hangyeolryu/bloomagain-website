# Firebase Configuration
# Copy this file to .env.local and fill in your actual values
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
NEXT_PUBLIC_BLOOMAGAIN_BACKEND_URL=https://bloomagain-backend-api-469607573966.asia-northeast3.run.app
BLOOMAGAIN_BACKEND_URL=https://bloomagain-backend-api-469607573966.asia-northeast3.run.app
BACKEND_APP_ID=<bloomagain-korea 백엔드 X-App-ID>
BACKEND_API_KEY=<bloomagain-korea 백엔드 X-API-Key>
# Instagram 자동 게시 (scripts/instagram/README.md)
IG_ACCESS_TOKEN=<Meta 개발자 콘솔 → Instagram API → Generate token>
IG_USER_ID=<node scripts/instagram/publish.mjs --whoami>
IG_GRAPH_HOST=graph.instagram.com
SEOUL_API_KEY=<data.seoul.go.kr 인증키 — 서울 문화행사 갈 곳 카드>
# Meta 광고 (scripts/meta-ads/README.md)
META_ADS_TOKEN=<비즈니스 관리자 → 시스템 사용자 → 토큰 생성 (ads_management, ads_read)>
META_AD_ACCOUNT_ID=<광고 계정 ID. act_ 붙여도 되고 숫자만 넣어도 된다>
META_APP_ID=<Meta 앱 ID (앱설치 광고의 promoted_object)>
META_PAGE_ID=<광고를 내보낼 페이스북 페이지 ID>
